# Deployment-Konfiguration fuer ./deploy.sh
# Kopieren nach .deploy.env (steht in .gitignore und wird nie committet).

# SSH-Zugang (netcup CCP -> Webhosting -> SSH bzw. Plesk -> Websites & Domains -> SSH-Zugang)
DEPLOY_USER=hosting123456
DEPLOY_HOST=hosting123456.a2e7f.netcup.net
DEPLOY_PORT=22

# Webspace-Ordner der Subdomain (relativ zum SSH-Home). Dokumentstamm: <DEPLOY_SITE>/<DEPLOY_LINK>/public
DEPLOY_SITE=aromacare.caryssa.at
DEPLOY_LINK=app
# Ordner fuer releases/, shared/ und uploads/ (liegt neben dem Link)
DEPLOY_APP_DIR=aromacare-app

# PHP-CLI auf dem Server (mind. 8.2). Leer lassen = automatisch suchen.
DEPLOY_PHP=/usr/local/php83/bin/php

DEPLOY_BRANCH=main
# Wie viele alte Releases fuer einen schnellen Rollback auf dem Server bleiben
DEPLOY_KEEP=5
# Adresse fuer den Test nach dem Deployment (<URL>/up)
DEPLOY_URL=https://aromacare.caryssa.at

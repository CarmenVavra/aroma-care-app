APP_NAME=AromaCare
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST="mxe86c.netcup.net"
MAIL_PORT=587
MAIL_USERNAME="admin@caryssa.at"
MAIL_PASSWORD="schnuFFi69!!"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="admin@caryssa.at"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Impressum / Datenschutzerklärung (Privatperson: ohne Straße, ohne Telefon) ---
# LEGAL_COUNTRY_CODE: DE (Deutschland) oder AT/AUT (Österreich) – steuert die Gesetzesverweise.
LEGAL_NAME="Vorname Nachname"
LEGAL_POSTAL_CODE="00000"
LEGAL_CITY="Ort"
LEGAL_COUNTRY="Deutschland"
LEGAL_COUNTRY_CODE=DE
LEGAL_EMAIL="kontakt@example.com"
LEGAL_VAT_ID=
LEGAL_CONTENT_RESPONSIBLE="${LEGAL_NAME}"
LEGAL_HOSTER_NAME="netcup GmbH"
LEGAL_HOSTER_ADDRESS="Daimlerstraße 25, 76185 Karlsruhe, Deutschland"
LEGAL_PRIVACY_UPDATED_AT="11/2026"

# Produktdaten-Suche nach dem Scan (nur die Barcode-Nummer wird gesendet, siehe Datenschutzerklaerung)
PRODUCT_LOOKUP_ENABLED=true
PRODUCT_LOOKUP_SOURCES=open_beauty_facts,open_food_facts,open_products_facts,upcitemdb

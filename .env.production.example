# Vorlage fuer die .env auf dem netcup-Server (https://aromacare.caryssa.at).
# `./deploy.sh --setup` legt sie als ~/aromacare.caryssa.at/aromacare-app/shared/.env an,
# erzeugt den APP_KEY und uebernimmt MAIL_* und LEGAL_* aus der lokalen .env.
# Passwoerter in einfache Hochkommas setzen.

APP_NAME=AromaCare
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Europe/Vienna
APP_URL=https://aromacare.caryssa.at

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_AT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# SQLite: Die Datei liegt in shared/database/database.sqlite und ueberlebt jedes Release
# (deploy.sh verlinkt sie nach database/database.sqlite). DB_DATABASE bewusst leer lassen.
DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=1440
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
# Im Webhosting laeuft kein dauerhafter Queue-Worker: Mails (Passwort vergessen) gehen
# direkt beim Request raus. Die Notification bleibt ShouldQueue und nutzt auf einem
# Server mit Worker automatisch die Queue (QUEUE_CONNECTION=database + queue:work).
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=aromacare

# netcup-Postfach. Wird fuer "Passwort vergessen" gebraucht. Der Absender muss das Postfach sein.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# --- LEGAL: Impressum & Datenschutzerklaerung (Privatperson, ohne Strasse und Telefon) ---
LEGAL_NAME=
LEGAL_POSTAL_CODE=
LEGAL_CITY=
LEGAL_COUNTRY=Österreich
LEGAL_COUNTRY_CODE=AT
LEGAL_EMAIL=
LEGAL_VAT_ID=
LEGAL_CONTENT_RESPONSIBLE="${LEGAL_NAME}"
LEGAL_HOSTER_NAME="netcup GmbH"
LEGAL_HOSTER_ADDRESS="Daimlerstraße 25, 76185 Karlsruhe, Deutschland"
LEGAL_PRIVACY_UPDATED_AT="11/2026"

# Produktdaten-Suche nach dem Scan (nur die Barcode-Nummer wird gesendet, siehe Datenschutzerklaerung)
PRODUCT_LOOKUP_ENABLED=true
PRODUCT_LOOKUP_SOURCES=open_beauty_facts,open_food_facts,upcitemdb
